{
  "name": "codewalk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @codewalk/core build && pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec postgres psql -U codewalk -d codewalk"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.5",
    "jsdom": "^30.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.0.3"
  }
}